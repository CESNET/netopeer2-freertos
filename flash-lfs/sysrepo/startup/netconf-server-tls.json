{
  "ietf-netconf-server:netconf-server": {
    "listen": {
      "endpoints": {
        "endpoint": [
          {
            "name": "default-tls",
            "tls": {
              "tcp-server-parameters": {
                "local-bind": [
                  {
                    "local-address": "0.0.0.0"
                  }
                ]
              },
              "tls-server-parameters": {
                "server-identity": {
                  "certificate": {
                    "central-keystore-reference": {
                      "asymmetric-key": "serverkey",
                      "certificate": "servercert"
                    }
                  }
                },
                "client-authentication": {
                  "ca-certs": {
                    "central-truststore-reference": "cacerts"
                  },
                  "ee-certs": {
                    "central-truststore-reference": "eecerts"
                  }
                }
              },
              "netconf-server-parameters": {
                "client-identity-mappings": {
                  "cert-to-name": [
                    {
                      "id": 1,
                      "fingerprint": "04:09:85:68:72:F8:8D:BC:DA:06:68:8E:CF:B0:0F:14:6E:F8:54:D4:D6:8D:6C:5C:A3:1E:AF:44:DD:19:6C:8A:FE",
                      "map-type": "ietf-x509-cert-to-name:specified",
                      "name": "tls-test"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "ietf-keystore:keystore": {
    "asymmetric-keys": {
      "asymmetric-key": [
        {
          "name": "serverkey",
          "public-key-format": "ietf-crypto-types:subject-public-key-info-format",
          "public-key": "",
          "private-key-format": "ietf-crypto-types:rsa-private-key-format",
          "cleartext-private-key": "",
          "certificates": {
            "certificate": [
              {
                "name": "servercert",
                "cert-data": ""
              }
            ]
          }
        }
      ]
    }
  },
  "ietf-truststore:truststore": {
    "certificate-bags": {
      "certificate-bag": [
        {
          "name": "cacerts",
          "certificate": [
            {
              "name": "cacert",
              "cert-data": ""
            }
          ]
        },
        {
          "name": "eecerts",
          "certificate": [
            {
              "name": "eecert",
              "cert-data": ""
            }
          ]
        }
      ]
    }
  }
}